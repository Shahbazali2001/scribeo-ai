# Backend API Configuration (FastAPI + Supabase + Gemini + OCR Service)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scribeo
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-never-expose-to-client
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
STORAGE_BUCKET=scans

OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_KEY=change-me-shared-ocr-secret

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

DAILY_SCAN_LIMIT=30
DAILY_SUMMARY_LIMIT=20
MIN_SUMMARY_WORDS=80
LANG_MIN_CHARS=25
ENGLISH_MIN_PROB=0.65
MIN_APP_VERSION=1.0.0
